# Copie esse arquivo para ".env" e preencha os valores reais.
# NUNCA commite o ".env" de verdade (ele já está no .gitignore).

# URL da API do back antigo (nao referenciada em nenhum arquivo hoje -
# parece resquicio de uma versao anterior do front; confirmar antes de remover)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Segredo usado pra assinar/verificar o JWT de sessao. Use uma string
# longa e aleatoria em producao (ex: openssl rand -base64 48)
JWT_SECRET=

# Postgres compartilhado com o zentrax-be
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public&connection_limit=10"

# URL publica do app, usada para montar links (ex: redefinicao de senha)
NEXT_PUBLIC_APP_URL=https://app.zentrax.dvls.com.br

# Envio de e-mail (SendGrid) - "esqueci minha senha" fica em modo silencioso
# (so loga no console, sem quebrar) ate essas duas variaveis serem preenchidas
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=naoresponda@zentrax.dvls.com.br

# Pagamentos (Stripe) - botao "Renovar agora" cai no aviso de WhatsApp
# ate STRIPE_SECRET_KEY ser preenchida. STRIPE_WEBHOOK_SECRET vem do
# endpoint configurado em dashboard.stripe.com/webhooks apontando pra
# https://app.zentrax.dvls.com.br/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Valores e duracao de cada plano (centavos e dias) - ajuste pros valores reais
STRIPE_PLANO_MENSAL_CENTAVOS=4990
STRIPE_PLANO_MENSAL_DIAS=30
STRIPE_PLANO_TRIMESTRAL_CENTAVOS=13490
STRIPE_PLANO_TRIMESTRAL_DIAS=90
STRIPE_PLANO_ANUAL_CENTAVOS=47990
STRIPE_PLANO_ANUAL_DIAS=365
